# ---------------------------------------------------------------------------
# Files that must NOT be sent to the Docker daemon / baked into the image.
# ---------------------------------------------------------------------------

# Version control, CI and editors
.git
.github
.gitignore
.vscode
.idea
.cursorignore

# Python virtual envs, caches and build artefacts
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.pytype

# Node / Angular frontend (built and deployed separately from this image)
node_modules
**/node_modules
frontend/.angular
frontend/dist

# Secrets - injected at runtime with --env-file / -v instead
.env
.env.*
!.env.example
sa-key.json
*.pem
*.p12

# Runtime state - regenerated by the app, mounted as volumes in docker-compose
sessions.log
useronline.json
.adk
**/.adk
artifacts

# OS noise
.DS_Store
**/.DS_Store
